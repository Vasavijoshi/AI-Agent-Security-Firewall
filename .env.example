# Copy this file to .env — .env itself is gitignored and must never be committed.
# The repo must run end-to-end with the defaults below and no API key.

LLM_PROVIDER=mock

# Required only when LLM_PROVIDER=anthropic. Leave unset to run fully on MockProvider.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Pins each agent's expected image digest for identity/issuer.py's attestation check
# (AGENTFW_CONTEXT.md §2). Left unset, attestation still works (a fresh clone must — see
# identity/issuer.py's AGENT_REGISTRY WHY comment) but runs "unpinned": image identity isn't
# verified, only the compose service label is, and every attest logs a loud warning saying so.
# To pin for real, after `docker compose build`:
#   docker inspect <image tag, e.g. agentfw-agent> --format '{{.Id}}'
# and set the matching var below.
# EXPECTED_DIGEST_AGENT=sha256:...
# EXPECTED_DIGEST_FINANCE_AGENT=sha256:...
# EXPECTED_DIGEST_SUPPORT_AGENT=sha256:...
